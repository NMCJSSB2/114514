local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local repairEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Generator"):WaitForChild("RepairEvent")

local ANIMATION_ID = "rbxassetid://127083088972311"

local gui = nil
local btn = nil
local btnIcon = nil
local currentTarget = nil
local currentState = false
local lastGenCount = 0

local animator = nil
local animTrack = nil

local function stopAnimation()
    if animTrack then
        pcall(function()
            animTrack:Stop()
            animTrack:Destroy()
        end)
        animTrack = nil
    end
end

local function playAnimation()
    local character = LocalPlayer.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    if animTrack and animTrack.IsPlaying then return end

    local animation = Instance.new("Animation")
    animation.AnimationId = ANIMATION_ID

    local ok, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    if ok and track then
        track.Looped = true
        track.Priority = Enum.AnimationPriority.Action4
        track:Play()
        animTrack = track
    end
end

local function createGUI()
    if gui then
        gui:Destroy()
        gui = nil
        btn = nil
        btnIcon = nil
    end
    
    gui = Instance.new("ScreenGui")
    gui.ResetOnSpawn = false
    gui.Name = "GeneratorRepairGUI"
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    
    btn = Instance.new("ImageButton")
    btn.Size = UDim2.new(0, 60, 0, 60)
    btn.Position = UDim2.new(0.67, 0, 0.8, -45)
    btn.BackgroundTransparency = 1
    btn.Image = "rbxassetid://91223269317292"
    btn.ImageTransparency = 0.5
    btn.Visible = false
    btn.Parent = gui
    
    btnIcon = Instance.new("ImageLabel")
    btnIcon.Size = UDim2.new(1, 0, 1, 0)
    btnIcon.Position = UDim2.new(0, 0, 0, 0)
    btnIcon.BackgroundTransparency = 1
    btnIcon.Image = "rbxassetid://101967215154019"
    btnIcon.ImageTransparency = 0.3
    btnIcon.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        if currentState then
            currentState = false
            btn.ImageColor3 = Color3.fromRGB(255, 255, 255)
            stopAnimation()

            if currentTarget then
                repairEvent:FireServer(currentTarget.Point, false)
            end

            local closest = getClosestGeneratorPoint()
            if closest then
                btn.Visible = true
                currentTarget = closest
            else
                btn.Visible = false
                currentTarget = nil
            end
            return
        end

        if not currentTarget then return end

        currentState = true
        btn.ImageColor3 = Color3.fromRGB(0, 255, 0)
        repairEvent:FireServer(currentTarget.Point, true)
        playAnimation()
        btn.Visible = true
    end)
end

local function checkAndRecreateGUI()
    if not gui or not gui.Parent then
        createGUI()
    end
end

local function getFolderNames()
    return {"Gens", "Generators", "new Generators", "newGenerators", "Generator"}
end

local function getGeneratorFolders()
    local folders = {}
    local map = Workspace:FindFirstChild("Map")
    if not map then return folders end

    for _, folderName in pairs(getFolderNames()) do
        local folder = map:FindFirstChild(folderName)
        if folder then
            table.insert(folders, folder)
        end
    end

    local resources = map:FindFirstChild("Resources") or map:FindFirstChild("resources")
    if resources then
        for _, folderName in pairs(getFolderNames()) do
            local folder = resources:FindFirstChild(folderName)
            if folder then
                table.insert(folders, folder)
            end
        end
        local genFolder = resources:FindFirstChild("Generators") or resources:FindFirstChild("generators")
        if genFolder and not table.find(folders, genFolder) then
            table.insert(folders, genFolder)
        end
    end

    return folders
end

local function getAllGeneratorPoints()
    local points = {}
    local folders = getGeneratorFolders()

    for _, folder in pairs(folders) do
        for _, gen in pairs(folder:GetChildren()) do
            if gen.Name:match("Generator") then
                for _, point in pairs(gen:GetChildren()) do
                    if point.Name:match("GeneratorPoint") and point:IsA("BasePart") then
                        table.insert(points, {
                            Point = point,
                            Generator = gen,
                            Folder = folder
                        })
                    end
                end
            end
        end
    end
    return points
end

local function getGeneratorCount()
    local count = 0
    local folders = getGeneratorFolders()

    for _, folder in pairs(folders) do
        for _, gen in pairs(folder:GetChildren()) do
            if gen.Name:match("Generator") then
                count = count + 1
            end
        end
    end
    return count
end

local function getClosestGeneratorPoint()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local points = getAllGeneratorPoints()
    local closest = nil
    local closestDist = math.huge
    
    for _, data in pairs(points) do
        local point = data.Point
        if point and point:IsA("BasePart") then
            local dist = (point.Position - root.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = data
            end
        end
    end
    
    if closest and closestDist <= 2 then
        return closest
    end
    return nil
end

local function updateButtonVisibility()
    checkAndRecreateGUI()
    
    if not btn then return end
    
    if currentState then
        btn.Visible = true
        return
    end

    local character = LocalPlayer.Character
    if not character then
        btn.Visible = false
        currentTarget = nil
        return
    end
    
    local closest = getClosestGeneratorPoint()
    if closest then
        btn.Visible = true
        currentTarget = closest
    else
        btn.Visible = false
        currentTarget = nil
    end
end

local function allLampsEnabled(gen)
    local lampNames = {"Lamp1", "Lamp2", "Lamp3"}
    local found = 0
    local enabled = 0

    for _, lampName in ipairs(lampNames) do
        local lamp = gen:FindFirstChild(lampName, true)
        if lamp then
            local pointLight = lamp:FindFirstChildOfClass("PointLight")
            if pointLight then
                found = found + 1
                if pointLight.Enabled then
                    enabled = enabled + 1
                end
            end
        end
    end

    return found == 3 and enabled == 3
end

local function createHitBoxBillboards()
    local folders = getGeneratorFolders()

    for _, folder in pairs(folders) do
        for _, gen in pairs(folder:GetChildren()) do
            if gen.Name:match("Generator") then
                local hitbox = gen:FindFirstChild("HitBox")
                if hitbox and hitbox:IsA("BasePart") then
                    local existing = hitbox:FindFirstChild("GeneratorBillboard")

                    local hasPoints = false
                    for _, child in pairs(gen:GetChildren()) do
                        if child.Name:match("GeneratorPoint") then
                            hasPoints = true
                            break
                        end
                    end

                    if not hasPoints then
                        if existing then
                            existing:Destroy()
                        end
                    else
                        local color = Color3.fromRGB(0, 255, 0)
                        if allLampsEnabled(gen) then
                            color = Color3.fromRGB(255, 0, 0)
                        end

                        if existing then
                            local label = existing:FindFirstChildOfClass("ImageLabel")
                            if label then
                                label.ImageColor3 = color
                            end
                        else
                            local billboard = Instance.new("BillboardGui")
                            billboard.Name = "GeneratorBillboard"
                            billboard.Adornee = hitbox
                            billboard.Size = UDim2.new(0, 30, 0, 30)
                            billboard.StudsOffset = Vector3.new(0, 2, 0)
                            billboard.MaxDistance = 9999
                            billboard.AlwaysOnTop = true
                            billboard.Parent = hitbox

                            local imageLabel = Instance.new("ImageLabel")
                            imageLabel.Size = UDim2.new(1, 0, 1, 0)
                            imageLabel.BackgroundTransparency = 1
                            imageLabel.Image = "rbxassetid://116363952886564"
                            imageLabel.ImageTransparency = 0.5
                            imageLabel.ImageColor3 = color
                            imageLabel.Parent = billboard
                        end
                    end
                end
            end
        end
    end
end

local function checkGeneratorChanges()
    local currentCount = getGeneratorCount()
    if currentCount ~= lastGenCount then
        lastGenCount = currentCount
        if gui then
            gui:Destroy()
            gui = nil
            btn = nil
            btnIcon = nil
        end
        createGUI()
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    animator = nil
    animTrack = nil
    if currentState then
        task.wait(1)
        playAnimation()
    end
end)

createGUI()
lastGenCount = getGeneratorCount()

RunService.Heartbeat:Connect(function()
    updateButtonVisibility()
    createHitBoxBillboards()
    checkGeneratorChanges()

    if currentState and (not animTrack or not animTrack.IsPlaying) then
        playAnimation()
    end
end)

task.spawn(function()
    while true do
        task.wait(10)
        checkAndRecreateGUI()
    end
end)
